# =============================================
# V-GREEN Platform — Frontend Environment
# =============================================
# Copy file này thành `.env.local` (dev) hoặc `.env.production` (prod)
# và điền giá trị thật. KHÔNG commit file có secret.

# ---------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------
# Dev:   http://localhost:3001/api
# Prod:  https://api.your-domain.com/api
VITE_API_URL=http://localhost:3001/api

# ---------------------------------------------------------------
# Feature flags (optional)
# ---------------------------------------------------------------
# Bật/tắt dev-mode fallback (localStorage auth, mock admin)
# Chỉ bật =true khi chạy local; LUÔN để false trên production.
VITE_ENABLE_DEV_FALLBACK=false

# Bật Sentry/Datadog (để trống = tắt)
VITE_SENTRY_DSN=