# =============================================
# V-GREEN Backend — Environment Variables
# =============================================
# Copy file này thành `server/.env` và điền giá trị thật.
# KHÔNG commit `server/.env` (đã có trong .gitignore).

# ---------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------
# Lấy từ Neon Console → Project → Connection Details → Pooled
# sslmode=require là bắt buộc với Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------------------------------------------------------------
# JWT secrets (BẮT BUỘC mạnh trên production — tối thiểu 32 ký tự)
# ---------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-48-byte-random-base64url
JWT_REFRESH_SECRET=replace-with-different-48-byte-random-base64url

JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---------------------------------------------------------------
# HTTP Server
# ---------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ---------------------------------------------------------------
# CORS — danh sách domain được phép gọi API (phân tách bằng dấu phẩy)
# Production: chỉ để domain thật. KHÔNG để "*".
# ---------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------
# Admin mặc định (chỉ dùng lần đầu khi DB trống)
# ---------------------------------------------------------------
ADMIN_PHONE=admin
ADMIN_PASSWORD=change-me-on-production
ADMIN_NAME=Quản trị viên

# ---------------------------------------------------------------
# Referral system
# ---------------------------------------------------------------
# Mã giới thiệu fallback dùng khi user đăng ký không nhập mã.
# Phải tồn tại trong users.referral_code (referrer nhận thưởng signup).
FALLBACK_REFERRAL_CODE=VIC1289

# ---------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------
# Sentry DSN cho error tracking (để trống = tắt)
SENTRY_DSN=

# Log level: error | warn | info | http | debug
LOG_LEVEL=info